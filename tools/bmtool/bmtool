BM_USAGE="Usage:
$0 <cmd> <benchmark> <scale> [<variants>] [options]

cmds:
  run <ior|lsmio|lmp> <local|bake|small|large|baseline> [<variants>] [--ssd] [--archive|--no-archive] [--resume] [--dest=<path>]
  parse <ior|lsmio|lmp> <local|bake|small|large|baseline> [<variant>] [--ssd]
  archive <lsmio> <local|bake|small|large|baseline> [<variant>] [--dest=<path>]
  dirs
  load-modules
"

BM_HELP_TEXT="LSMIO Benchmark Suite Orchestration CLI (bmtool)

Usage:
  $0 <cmd> <benchmark> <scale> [<variants>] [options]

Commands:
  run             Execute benchmark jobs across HPC compute nodes
  parse           Extract metrics and format performance summaries
  archive         Archive active outputs to timestamped / Arm-ID directory
  dirs            Setup active Lustre and scratch directory hierarchies
  load-modules    Inspect and verify required HPC cluster modules

Benchmarks:
  ior             IOR Parallel I/O benchmark
  lsmio           LSMIO Log-Structured Merge benchmark
  lmp             LAMMPS ReaxFF Molecular Dynamics benchmark

Scales:
  local           1 task on 1 node (single process smoke testing)
  bake            1, 2, 4, 8 tasks on 1, 2, 4, 8 nodes
  small           1, 2, 4, 8, 16, 24, 32, 40, 48 tasks on 1 task/node
  large           4, 8, 16, 32, 64, 128, 192, 256 tasks on 4 tasks/node
  baseline        Standardized baseline scaling evaluation

Variants (for 'lsmio baseline'):
  omitted / base  Execute default baseline configuration
  <variant>       Single variant key (e.g. footer, btree, mmap, autotune)
  <v1>,<v2>,...   Comma-separated list (e.g. footer,manoff,autotune)
  all             Canonical sequence of all 38 matrix variants

Options:
  --ssd           Use SSD storage instead of HDD
  --archive       Force automatic archiving after each variant run
                  (Default: 'yes' when multiple variants or 'all'; 'no' for single variant)
  --no-archive    Disable automatic archiving after variant execution
  --resume        Skip variant if archive target directory (outputs-\${ARM_ID}) exists
  --out-dir <dir> Archive destination directory (default: \$BM_PATH/lsmio-archive)
                  Aliases: --output-dir <dir>, --dest <dir>, --dest=<dir>
  -h, --help      Display this comprehensive help guide and exit 0
"

export BM_SCRIPT=`realpath $0`
export BM_DIRNAME=`dirname $BM_SCRIPT`

fatal_error() {
  echo "ERROR: $1"
  echo "$BM_USAGE"
  exit 1
}

# Sanity checks
if [ -z "$BM_SCRIPT" -o -z "$BM_DIRNAME" ]; then
  fatal_error "Failed to determine the script environment"
fi

. $BM_DIRNAME/jobs/lsmio-variants.in.sh

# Early help intercept: exit 0 before SB_EMAIL / SB_ACCOUNT validation (INV-MULTI-7)
if [ $# -eq 0 ]; then
  echo "$BM_HELP_TEXT"
  exit 0
fi
for _arg in "$@"; do
  case "$_arg" in
    -h|--help|help)
      echo "$BM_HELP_TEXT"
      exit 0
      ;;
  esac
done

# SBatch settings
if [ -z "$SB_EMAIL" ]; then
  fatal_error "Email for SBATCH is not set using SB_EMAIL: $SB_EMAIL"
fi
if [ -z "$SB_ACCOUNT" ]; then
  fatal_error "Account for SBATCH is not set using SB_ACCOUNT: $SB_ACCOUNT"
fi

# Parse arguments
if [ "$1" = "parse" ]; then
  PASS_CMD="parse"
elif [ "$1" = "run" ]; then
  PASS_CMD="run"
elif [ "$1" = "archive" ]; then
  PASS_CMD="archive"
elif [ "$1" = "load-modules" ]; then
  PASS_CMD="load-modules"
elif [ "$1" = "dirs" ]; then
  PASS_CMD="dirs"
elif [ -z "$1" ]; then
  fatal_error "Please pass a non-empty cmd."
else
  fatal_error "Invalid cmd: [$1]. Please pass a valid cmd."
fi

if [ "$2" = "ior" ]; then
  JOB_TOOL="ior"
elif [ "$2" = "lsmio" ]; then
  JOB_TOOL="lsmio"
elif [ "$2" = "lmp" ]; then
  JOB_TOOL="lmp"
elif [ "$PASS_CMD" != "load-modules" -a "$PASS_CMD" != "dirs" ]; then
  fatal_error "Please pass either ior, lsmio, or lmp as a first cmd argument."
fi

if [ "$PASS_CMD" = "archive" -a "$JOB_TOOL" != "lsmio" ]; then
  fatal_error "archive command is currently only supported for lsmio."
fi

if [ "$PASS_CMD" = "run" ] || [ "$PASS_CMD" = "parse" ] || [ "$PASS_CMD" = "archive" ]; then
  JOB_SCALE="$3"

  if [ "$JOB_SCALE" != "local" -a "$JOB_SCALE" != "bake" -a "$JOB_SCALE" != "small" -a "$JOB_SCALE" != "large" -a "$JOB_SCALE" != "baseline" ]; then
    fatal_error "Unknown second argument for $PASS_CMD cmd: [$JOB_SCALE]"
  fi
fi

BM_VARIANTS_RAW=""
BM_VARIANT=""
BM_ARCHIVE_DEST=""
BM_ARCHIVE_OVERRIDE=""
BM_RESUME="no"
DO_ARCHIVE="no"
EXPANDED_VARIANTS="default"

if [ "$PASS_CMD" = "run" ] || [ "$PASS_CMD" = "parse" ] || [ "$PASS_CMD" = "archive" ]; then
  shift 3
  if [ "$JOB_SCALE" = "baseline" ]; then
    # Positional variant token (if present and not starting with --)
    if [ $# -gt 0 ]; then
      case "$1" in
        --*)
          BM_VARIANTS_RAW=""
          ;;
        *)
          BM_VARIANTS_RAW="$1"
          shift
          ;;
      esac
    fi

    # Parse baseline options
    while [ $# -gt 0 ]; do
      case "$1" in
        --ssd)
          LUSTRE_SSD=on
          ;;
        --archive)
          [ "$BM_ARCHIVE_OVERRIDE" != "no" ] || fatal_error "Cannot specify both --archive and --no-archive"
          BM_ARCHIVE_OVERRIDE="yes"
          ;;
        --no-archive)
          [ "$BM_ARCHIVE_OVERRIDE" != "yes" ] || fatal_error "Cannot specify both --archive and --no-archive"
          BM_ARCHIVE_OVERRIDE="no"
          ;;
        --resume)
          BM_RESUME="yes"
          ;;
        --dest=*|--out-dir=*|--output-dir=*)
          BM_ARCHIVE_DEST="${1#*=}"
          ;;
        --dest|--out-dir|--output-dir)
          _opt="$1"
          shift
          [ $# -gt 0 ] || fatal_error "Option $_opt requires an argument"
          BM_ARCHIVE_DEST="$1"
          ;;
        *)
          fatal_error "Unknown argument for $PASS_CMD cmd: [$1]"
          ;;
      esac
      shift
    done

    # Validate variant usage
    if [ "$JOB_TOOL" = "lsmio" ]; then
      EXPANDED_VARIANTS="$(bm_expand_variants "$BM_VARIANTS_RAW")" || fatal_error "Variant validation failed"
      # Count variant items
      VAR_COUNT=0
      _rem="$EXPANDED_VARIANTS"
      while [ -n "$_rem" ]; do
        case "$_rem" in
          *,*)
            VAR_COUNT=$(( VAR_COUNT + 1 ))
            _rem="${_rem#*,}"
            ;;
          *)
            VAR_COUNT=$(( VAR_COUNT + 1 ))
            _rem=""
            ;;
        esac
      done

      if [ "$PASS_CMD" = "archive" ] && [ "$VAR_COUNT" -gt 1 ]; then
        fatal_error "archive command does not support multiple variants"
      fi

      if [ "$PASS_CMD" = "archive" ]; then
        if [ "$EXPANDED_VARIANTS" = "default" ] || [ "$EXPANDED_VARIANTS" = "base" ]; then
          BM_VARIANT=""
        else
          BM_VARIANT="$EXPANDED_VARIANTS"
        fi
      else
        if [ "$BM_VARIANTS_RAW" = "default" ] || [ "$BM_VARIANTS_RAW" = "base" ]; then
          BM_VARIANT=""
        else
          BM_VARIANT="$BM_VARIANTS_RAW"
        fi
      fi

      # Archiving decision matrix (INV-MULTI-2)
      if [ -n "$BM_ARCHIVE_OVERRIDE" ]; then
        DO_ARCHIVE="$BM_ARCHIVE_OVERRIDE"
      elif [ "$VAR_COUNT" -gt 1 ]; then
        DO_ARCHIVE="yes"
      else
        DO_ARCHIVE="no"
      fi
    else
      # For non-lsmio benchmarks, variant is strictly rejected (INV-ARCH-3)
      if [ -n "$BM_VARIANTS_RAW" ]; then
        fatal_error "Benchmark '$JOB_TOOL' does not support variant configurations; variants are supported exclusively for 'lsmio'."
      fi
      EXPANDED_VARIANTS="default"
      BM_VARIANT=""
      DO_ARCHIVE="no"
    fi
  else
    # Legacy scales: local, bake, small, large
    if [ "$PASS_CMD" = "run" ] || [ "$PASS_CMD" = "parse" ]; then
      if [ $# -gt 0 ]; then
        if [ "$1" = "--ssd" ]; then
          LUSTRE_SSD=on
        else
          fatal_error "Unknown argument for $PASS_CMD cmd: [$1]"
        fi
        shift
      fi
      if [ $# -gt 0 ]; then
        fatal_error "Unknown argument for $PASS_CMD cmd: [$1]"
      fi
    elif [ "$PASS_CMD" = "archive" ]; then
      while [ $# -gt 0 ]; do
        case "$1" in
          --dest=*|--out-dir=*|--output-dir=*)
            BM_ARCHIVE_DEST="${1#*=}"
            ;;
          --dest|--out-dir|--output-dir)
            _opt="$1"
            shift
            if [ $# -eq 0 ]; then
              fatal_error "Option $_opt requires an argument"
            fi
            BM_ARCHIVE_DEST="$1"
            ;;
          *)
            fatal_error "Unknown argument for $PASS_CMD cmd: [$1]"
            ;;
        esac
        shift
      done
    fi
  fi
fi

echo "Entered cmd summary:
- Passed cmd: $PASS_CMD
- Cmd param-1: $JOB_TOOL
- Cmd param-2: $JOB_SCALE
- Cmd optional param: SSD=$LUSTRE_SSD
- Cmd optional param: Variant=$BM_VARIANT
- Cmd optional param: Archive Dest=$BM_ARCHIVE_DEST

Environment settings:
- Email: $SB_EMAIL
- Account: $SB_ACCOUNT

Executing...
"

# Execute
# Export: BM_CMD,BM_TYPE,BM_SCALE,BM_SSD,BM_VARIANT,BM_ARCHIVE_DEST,BM_SETUP
: "${BM_SETUP:=NATIVE-M}"
export BM_SETUP
export BM_CMD="$PASS_CMD"
export BM_TYPE="$JOB_TOOL"
export BM_SCALE="$JOB_SCALE"
export BM_SSD="$LUSTRE_SSD"
export BM_VARIANT="$BM_VARIANT"
export BM_ARCHIVE_DEST="$BM_ARCHIVE_DEST"

. $BM_DIRNAME/include/vars.in.sh

# example: CMD:run TYPE:ior ARGS:local
if [ "$BM_CMD" = "run" ]; then
  . $BM_DIRNAME/jobs/submission.in.sh

  case $BM_TYPE in
    ior)
      ;;
    lsmio)
      ;;
    lmp)
      ;;
    *)
      fatal_error "Uknown $BM_CMD parameter: $BM_TYPE."
      ;;
  esac

  if [ "$BM_SCALE" = "local" ]; then
    run_local_job $BM_TYPE
  elif [ "$BM_SCALE" = "bake" ]; then
    run_bake_job $BM_TYPE
  elif [ "$BM_SCALE" = "small" ]; then
    run_small_job $BM_TYPE
  elif [ "$BM_SCALE" = "large" ]; then
    run_large_job $BM_TYPE
  elif [ "$BM_SCALE" = "baseline" ]; then
    if [ "$BM_TYPE" = "lsmio" ]; then
      : "${BM_ARCHIVE_DEST:=$BM_PATH/lsmio-archive}"
      export BM_ARCHIVE_DEST

      _rem="$EXPANDED_VARIANTS"
      while [ -n "$_rem" ]; do
        case "$_rem" in
          *,*)
            _v="${_rem%%,*}"
            _rem="${_rem#*,}"
            ;;
          *)
            _v="$_rem"
            _rem=""
            ;;
        esac

        if [ "$_v" = "default" ] || [ "$_v" = "base" ]; then
          CUR_VARIANT=""
        else
          CUR_VARIANT="$_v"
        fi

        export BM_VARIANT="$CUR_VARIANT"
        ARM_ID="$(bm_resolve_arm_id "$BM_SETUP" "$CUR_VARIANT")" || fatal_error "Failed to derive Arm ID for variant [$_v]"
        TARGET_ARCHIVE="${BM_ARCHIVE_DEST}/outputs-${ARM_ID}"

        # Idempotent Resumption Check (INV-MULTI-3)
        if [ "$BM_RESUME" = "yes" ] && [ -d "$TARGET_ARCHIVE" ]; then
          echo "[RESUME] Skipping variant '${_v}'"
          continue
        fi

        echo "=== Executing variant '${_v}' (ARM_ID: ${ARM_ID}) ==="
        run_baseline_job "$BM_TYPE" || fatal_error "Variant '${_v}' failed during execution"

        if [ "$DO_ARCHIVE" = "yes" ]; then
          echo "=== Auto-archiving variant '${_v}' ==="
          . $BM_DIRNAME/include/archive.in.sh
        fi
      done
    else
      run_baseline_job "$BM_TYPE"
    fi
  else
    fatal_error "Uknown $BM_CMD parameter: $BM_SCALE."
  fi
# example: CMD:parse TYPE:ior ARGS:local
elif [ "$BM_CMD" = "parse" ]; then
  . $BM_DIRNAME/include/dirs-vars.in.sh

  if [ "$BM_TYPE" = "ior" ]; then
    . $BM_DIRNAME/parse/ior-parse.sh
  elif [ "$BM_TYPE" = "lsmio" ]; then
    . $BM_DIRNAME/parse/lsmio-parse.sh
  elif [ "$BM_TYPE" = "lmp" ]; then
    . $BM_DIRNAME/parse/lmp-parse.sh
  else
    fatal_error "Uknown $BM_CMD parameter: $BM_TYPE."
  fi
elif [ "$BM_CMD" = "archive" ]; then
  . $BM_DIRNAME/include/archive.in.sh
elif [ "$BM_CMD" = "load-modules" ]; then
  . $BM_DIRNAME/include/load-modules.in.sh
  list_modules
elif [ "$BM_CMD" = "dirs" ]; then
  echo "Setting up directories..."
  . $BM_DIRNAME/jobs/dirs.in.sh
else
  fatal_error "Unknown error at cmd execution."
fi


