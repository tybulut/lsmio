"""Private worker executable for lsmiotool run allocation and rank tasks."""

import os
import sys
from typing import List, Optional, Sequence

# Calculate server path and add to sys.path
srv_path = os.path.normpath(
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
)
if srv_path not in sys.path:
    sys.path.insert(0, srv_path)


def main(f_argv: Optional[Sequence[str]] = None) -> int:
    """Execute private worker entry point for allocation or rank modes.

    Args:
        f_argv: Argument sequence (defaults to sys.argv[1:]).

    Returns:
        Integer exit code.
    """
    from lsmiotool.lib.cli import (
        PackageValidationError,
        SourcePackageValidator,
    )

    package_root = os.path.dirname(os.path.abspath(__file__))
    try:
        SourcePackageValidator.validate(package_root)
    except PackageValidationError as err:
        sys.stderr.write(f"Package validation error: {err}\n")
        return 1

    if f_argv is None:
        f_tokens: List[str] = sys.argv[1:]
    else:
        f_tokens = list(f_argv)

    if not f_tokens:
        sys.stderr.write("Usage: lsmiotool-worker <allocation|rank> <args...>\n")
        return 1

    mode = f_tokens[0].strip().lower()

    if mode == "allocation":
        if len(f_tokens) != 3:
            sys.stderr.write(
                "Usage: lsmiotool-worker allocation <manifest_path> <point_id>\n"
            )
            return 2

        manifest_path = f_tokens[1]
        point_id = f_tokens[2]

        from lsmiotool.lib.resources import ResourceLocator
        from lsmiotool.lib.worker import (
            AllocationController,
            AllocationControllerError,
        )

        runtime_layout = ResourceLocator.forSource(os.path.abspath(__file__))
        worker_exe = os.path.abspath(__file__)

        try:
            controller = AllocationController(
                f_worker_executable=worker_exe,
                f_asset_source=runtime_layout.asset_root,
                f_layout=None,
            )
            return controller.run(
                f_manifest_path=manifest_path,
                f_point_id=point_id,
            )
        except AllocationControllerError as err:
            sys.stderr.write(f"AllocationController error: {err}\n")
            return 1
        except Exception as err:
            sys.stderr.write(f"Worker error: {err}\n")
            return 1

    elif mode == "rank":
        if len(f_tokens) != 4:
            sys.stderr.write(
                "Usage: lsmiotool-worker rank <manifest_path> <point_id> <combination_desc>\n"
            )
            return 2

        manifest_path = f_tokens[1]
        point_id = f_tokens[2]
        combination_desc = f_tokens[3]

        from lsmiotool.lib.worker import (
            RankWorker,
            RankWorkerError,
        )

        try:
            worker = RankWorker()
            return worker.run(
                f_manifest_path=manifest_path,
                f_point_id=point_id,
                f_combination_desc=combination_desc,
            )
        except RankWorkerError as err:
            sys.stderr.write(f"RankWorker error: {err}\n")
            return 1
        except Exception as err:
            sys.stderr.write(f"Worker error: {err}\n")
            return 1

    else:
        sys.stderr.write(f"Unknown worker mode: {mode!r}\n")
        return 1


if __name__ == "__main__":
    sys.exit(main())
